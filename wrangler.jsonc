{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limpidwork-demo",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "limpid.harveydu.top", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
